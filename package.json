{
  "name": "@simplesuccess/utils",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.1.0",
  "description": "A modern, fully-typed TypeScript utility library",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src"
  },
  "keywords": [
    "utils",
    "typescript",
    "helpers",
    "lodash-alternative"
  ],
  "license": "MIT"
}